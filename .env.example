# ============================================================
# Telegram — публикация постов
# ============================================================
# Токен бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenHere

# Куда публиковать: @username канала или числовой chat_id (например -1001234567890)
TARGET_CHANNEL=@world_pharita

# ============================================================
# Telegram — чтение каналов-источников (нужен user-аккаунт, НЕ бот)
# Получить api_id / api_hash: https://my.telegram.org/apps (бесплатно)
# ============================================================
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890
# Файл сессии Telethon создастся автоматически при первом запуске
TELETHON_SESSION_NAME=pharita_bot_session
# Только для хостинга без постоянного диска (напр. Render) — см. README, раздел деплоя.
# Если задано, используется вместо файла сессии. Получить: python login_telethon.py
TELETHON_SESSION_STRING=

# Список каналов-источников через запятую (username без @, или t.me/... ссылки)
SOURCE_TG_CHANNELS=babymonster_news,bm_updates_example,another_bm_channel

# ============================================================
# YouTube Data API v3 (бесплатный ключ: https://console.cloud.google.com/)
# ============================================================
YOUTUBE_API_KEY=
# Официальный канал BABYMONSTER (можно оставить по умолчанию)
YOUTUBE_CHANNEL_ID=UCqwUnggBBct-AY2lAdI88jQ

# ============================================================
# Источники: включить/выключить (true/false)
# ============================================================
ENABLE_TELEGRAM_SOURCE=true
ENABLE_YOUTUBE_SOURCE=true
ENABLE_NEWS_RSS_SOURCE=true
ENABLE_TWITTER_SOURCE=true
ENABLE_INSTAGRAM_SOURCE=true
ENABLE_TIKTOK_SOURCE=false
ENABLE_WEVERSE_SOURCE=false

# ============================================================
# X (Twitter) — неофициально, через snscrape. Часто ломается.
# ============================================================
TWITTER_SEARCH_QUERIES=Pharita BABYMONSTER,파리타 베이비몬스터

# ============================================================
# Instagram — неофициально, через instaloader.
# Логин РЕКОМЕНДУЕТСЯ делать с отдельного "запасного" аккаунта,
# не с личного — instagram может временно ограничить аккаунт.
# Можно оставить пустым — тогда попытка анонимного чтения (менее надёжно).
# ============================================================
INSTAGRAM_LOGIN=
INSTAGRAM_PASSWORD=
INSTAGRAM_PROFILES=babymonster_official,pharita_profile_example
# Публичный аккаунт мамы Фариты (если известен) — публикуется всегда, с указанием источника
INSTAGRAM_MOM_PROFILE=

# ============================================================
# TikTok — неофициально, через TikTokApi (требует Playwright + ms_token)
# Инструкция получения ms_token — см. README.
# ============================================================
TIKTOK_MS_TOKEN=
TIKTOK_USERNAMES=babymonster_official

# ============================================================
# Weverse — неофициально, требует свою учётку фан-аккаунта
# ============================================================
WEVERSE_EMAIL=
WEVERSE_PASSWORD=
WEVERSE_COMMUNITY=BABYMONSTER

# ============================================================
# News RSS — Google News (бесплатный агрегатор, без ключа) + свои ленты
# ============================================================
NEWS_RSS_QUERIES=BABYMONSTER Pharita,BABYMONSTER 파리타,BABYMONSTER concert
NEWS_RSS_EXTRA_FEEDS=
NEWS_RSS_LANG=en-US

# ============================================================
# Прочее
# ============================================================
# Как часто проверять источники (в секундах)
POLL_INTERVAL_SECONDS=900
# Путь к базе данных дедупликации
DB_PATH=data/seen_items.sqlite3
LOG_LEVEL=INFO

# ============================================================
# Админ-бот — меню, ручная публикация, статистика
# ============================================================
# Telegram id аккаунта, которому доступны кнопки управления ботом
ADMIN_CHAT_ID=7947115426
# Сколько публикаций в сутки делает бот автоматически (случайно в этом диапазоне)
DAILY_POST_MIN=4
DAILY_POST_MAX=10
# Как часто присылать админу сводку найденного (в секундах, 3600 = раз в час)
HOURLY_DIGEST_SECONDS=3600

# ============================================================
# Переписывание текста из Telegram-каналов своими словами
# Google Gemini, бесплатный уровень: https://aistudio.google.com/apikey
# ============================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Медиа-посты из Telegram без подписи: сколько ждать (в минутах) текст из
# другого источника, прежде чем публиковать просто как "Фото"/"Видео"
TELEGRAM_HOLD_MINUTES=90
TELEGRAM_HOLD_MAX_MINUTES=120
